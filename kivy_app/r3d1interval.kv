#:kivy 2.0
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp

# Enhanced Color Palette
#:set bg_primary '#0A0A0F'
#:set bg_secondary '#151520'
#:set bg_tertiary '#1E1E2E'
#:set bg_card '#1A1A2E'
#:set text_primary '#FFFFFF'
#:set text_secondary '#8E8E9A'
#:set text_muted '#5A5A6E'
#:set accent_blue '#6C63FF'
#:set accent_cyan '#00D9FF'
#:set accent_green '#00E676'
#:set accent_red '#FF5252'
#:set accent_orange '#FF9100'
#:set accent_pink '#FF4081'
#:set accent_purple '#B388FF'
#:set gradient_start '#6C63FF'
#:set gradient_end '#00D9FF'

# ============= REUSABLE COMPONENTS =============

<GlowButton@Button>:
    size_hint_y: None
    height: dp(52)
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: sp(15)
    canvas.before:
        # Glow effect
        Color:
            rgba: get_color_from_hex(accent_blue + '33')
        RoundedRectangle:
            pos: self.x - dp(2), self.y - dp(2)
            size: self.width + dp(4), self.height + dp(4)
            radius: [dp(14)]
        # Main button
        Color:
            rgba: get_color_from_hex(accent_blue)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<IconButton@Button>:
    size_hint: None, None
    size: dp(44), dp(44)
    background_normal: ''
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_tertiary) if self.state == 'down' else get_color_from_hex(bg_secondary)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<TabButton@ToggleButton>:
    group: 'tabs'
    size_hint_y: None
    height: dp(44)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    font_size: sp(14)
    bold: True
    color: get_color_from_hex(text_primary) if self.state == 'down' else get_color_from_hex(text_muted)
    canvas.before:
        Color:
            rgba: get_color_from_hex(accent_blue + '22') if self.state == 'down' else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(8), self.y + dp(4)
            size: self.width - dp(16), self.height - dp(8)
            radius: [dp(10)]
    canvas.after:
        Color:
            rgba: get_color_from_hex(accent_blue) if self.state == 'down' else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(8), self.y
            size: self.width - dp(16), dp(3)
            radius: [dp(2)]

<CardBox@BoxLayout>:
    orientation: 'vertical'
    canvas.before:
        # Shadow
        Color:
            rgba: 0, 0, 0, 0.3
        RoundedRectangle:
            pos: self.x + dp(2), self.y - dp(2)
            size: self.size
            radius: [dp(16)]
        # Card background
        Color:
            rgba: get_color_from_hex(bg_card)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

# ============= HOME SCREEN =============
<HomeScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Premium Header
        BoxLayout:
            size_hint_y: None
            height: dp(70)
            padding: dp(20), dp(12)
            spacing: dp(12)
            canvas.before:
                # Header gradient
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size
                # Accent line at bottom
                Color:
                    rgba: get_color_from_hex(accent_blue + '44')
                Rectangle:
                    pos: self.x, self.y
                    size: self.width, dp(1)

            # App Icon
            Widget:
                size_hint: None, None
                size: dp(40), dp(40)
                canvas:
                    Color:
                        rgba: get_color_from_hex(accent_blue)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]
                    Color:
                        rgba: get_color_from_hex(accent_cyan)
                    Line:
                        circle: self.center_x, self.center_y, dp(12)
                        width: dp(3)

            # Title
            Label:
                text: 'R3D1 Timer'
                font_size: sp(22)
                bold: True
                color: get_color_from_hex(text_primary)
                halign: 'left'
                valign: 'center'
                text_size: self.size

            # Header buttons
            BoxLayout:
                size_hint_x: None
                width: dp(100)
                spacing: dp(8)

                IconButton:
                    on_press: app.root.current = 'stats'
                    canvas.after:
                        Color:
                            rgba: get_color_from_hex(accent_cyan)
                        Line:
                            points: [self.center_x - dp(8), self.center_y - dp(6), self.center_x - dp(8), self.center_y + dp(8), self.center_x - dp(2), self.center_y + dp(8), self.center_x - dp(2), self.center_y - dp(2), self.center_x + dp(4), self.center_y - dp(2), self.center_x + dp(4), self.center_y + dp(8), self.center_x + dp(10), self.center_y + dp(8), self.center_x + dp(10), self.center_y + dp(2)]
                            width: dp(2)
                            cap: 'round'
                            joint: 'round'

                IconButton:
                    on_press: app.root.current = 'settings'
                    canvas.after:
                        Color:
                            rgba: get_color_from_hex(text_secondary)
                        Line:
                            circle: self.center_x, self.center_y, dp(10)
                            width: dp(2)
                        Color:
                            rgba: get_color_from_hex(text_secondary)
                        Line:
                            points: [self.center_x, self.center_y - dp(14), self.center_x, self.center_y - dp(10)]
                            width: dp(2)
                            cap: 'round'

        # Tab Navigation
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            padding: dp(8), dp(4)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            TabButton:
                text: 'Profiles'
                state: 'down' if root.current_tab == 'profiles' else 'normal'
                on_press: root.switch_tab('profiles')

            TabButton:
                text: 'Pomodoro'
                state: 'down' if root.current_tab == 'pomodoro' else 'normal'
                on_press: root.switch_tab('pomodoro')

        # Content Area
        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)
            bar_color: get_color_from_hex(accent_blue)
            bar_inactive_color: get_color_from_hex(bg_tertiary)

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16)
                spacing: dp(12)

                # Profiles Tab
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if root.current_tab == 'profiles' else 0
                    opacity: 1 if root.current_tab == 'profiles' else 0
                    spacing: dp(12)

                    # Section Header
                    BoxLayout:
                        size_hint_y: None
                        height: dp(32)
                        Label:
                            text: 'Your Profiles'
                            font_size: sp(13)
                            color: get_color_from_hex(text_muted)
                            halign: 'left'
                            text_size: self.size
                            valign: 'center'
                        Label:
                            text: 'Tap to start'
                            font_size: sp(11)
                            color: get_color_from_hex(text_muted)
                            halign: 'right'
                            text_size: self.size
                            valign: 'center'

                    GridLayout:
                        id: profiles_grid
                        cols: 2
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height

                    # Add Profile Button
                    GlowButton:
                        text: '+  Create New Profile'
                        on_press: root.open_profile_editor()

                # Pomodoro Tab
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if root.current_tab == 'pomodoro' else 0
                    opacity: 1 if root.current_tab == 'pomodoro' else 0
                    spacing: dp(16)

                    # Today's Progress Card
                    BoxLayout:
                        size_hint_y: None
                        height: dp(100)
                        padding: dp(20)
                        canvas.before:
                            # Gradient background
                            Color:
                                rgba: get_color_from_hex('#FF5252' + '22')
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(16)]
                            Color:
                                rgba: get_color_from_hex(accent_red)
                            RoundedRectangle:
                                pos: self.x, self.y + self.height - dp(4)
                                size: self.width, dp(4)
                                radius: [dp(16), dp(16), 0, 0]

                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: "Today's Focus"
                                font_size: sp(13)
                                color: get_color_from_hex(text_secondary)
                                halign: 'left'
                                text_size: self.size
                            Label:
                                id: tomato_icons
                                text: ''
                                font_size: sp(20)
                                halign: 'left'
                                text_size: self.size

                        Label:
                            id: pomodoro_count
                            text: '0'
                            font_size: sp(48)
                            bold: True
                            color: get_color_from_hex(accent_red)
                            size_hint_x: None
                            width: dp(80)

                    # Task Input
                    BoxLayout:
                        size_hint_y: None
                        height: dp(52)
                        padding: dp(16), 0
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_card)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                            Color:
                                rgba: get_color_from_hex(bg_tertiary)
                            Line:
                                rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
                                width: dp(1)

                        TextInput:
                            id: pomo_task_input
                            hint_text: 'What are you working on?'
                            multiline: False
                            background_color: 0, 0, 0, 0
                            foreground_color: get_color_from_hex(text_primary)
                            hint_text_color: get_color_from_hex(text_muted)
                            cursor_color: get_color_from_hex(accent_blue)
                            padding: 0, dp(14)

                    # Pomodoro Timer Display
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(300)
                        spacing: dp(12)

                        Label:
                            text: 'Ready to Focus'
                            font_size: sp(14)
                            color: get_color_from_hex(text_secondary)
                            size_hint_y: None
                            height: dp(28)

                        # Timer Ring
                        Widget:
                            size_hint_y: None
                            height: dp(200)
                            canvas:
                                # Outer glow
                                Color:
                                    rgba: get_color_from_hex(accent_red + '11')
                                Line:
                                    circle: self.center_x, self.center_y, dp(95)
                                    width: dp(20)
                                # Background ring
                                Color:
                                    rgba: get_color_from_hex(bg_tertiary)
                                Line:
                                    circle: self.center_x, self.center_y, dp(85)
                                    width: dp(8)
                                # Progress ring
                                Color:
                                    rgba: get_color_from_hex(accent_red)
                                Line:
                                    circle: self.center_x, self.center_y, dp(85), 90, 90
                                    width: dp(8)
                                    cap: 'round'
                                # Inner circle
                                Color:
                                    rgba: get_color_from_hex(bg_card)
                                Ellipse:
                                    pos: self.center_x - dp(70), self.center_y - dp(70)
                                    size: dp(140), dp(140)

                            Label:
                                text: '25:00'
                                font_size: sp(44)
                                bold: True
                                center: self.parent.center
                                color: get_color_from_hex(text_primary)

                        # Start Button
                        BoxLayout:
                            size_hint_y: None
                            height: dp(56)
                            padding: dp(60), 0

                            Button:
                                text: 'Start Focus'
                                font_size: sp(16)
                                bold: True
                                background_normal: ''
                                background_color: 0, 0, 0, 0
                                color: 1, 1, 1, 1
                                on_press: app.root.current = 'pomodoro'
                                canvas.before:
                                    Color:
                                        rgba: get_color_from_hex(accent_red + '33')
                                    RoundedRectangle:
                                        pos: self.x - dp(2), self.y - dp(2)
                                        size: self.width + dp(4), self.height + dp(4)
                                        radius: [dp(30)]
                                    Color:
                                        rgba: get_color_from_hex(accent_red)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(28)]

                    # Session Info Cards
                    BoxLayout:
                        size_hint_y: None
                        height: dp(70)
                        spacing: dp(8)

                        BoxLayout:
                            orientation: 'vertical'
                            padding: dp(12)
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex(bg_card)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]
                            Label:
                                text: 'Focus'
                                font_size: sp(11)
                                color: get_color_from_hex(text_muted)
                            Label:
                                id: pomo_focus_display
                                text: '25 min'
                                font_size: sp(16)
                                bold: True
                                color: get_color_from_hex(text_primary)

                        BoxLayout:
                            orientation: 'vertical'
                            padding: dp(12)
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex(bg_card)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]
                            Label:
                                text: 'Break'
                                font_size: sp(11)
                                color: get_color_from_hex(text_muted)
                            Label:
                                id: pomo_break_display
                                text: '5 min'
                                font_size: sp(16)
                                bold: True
                                color: get_color_from_hex(text_primary)

                        BoxLayout:
                            orientation: 'vertical'
                            padding: dp(12)
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex(bg_card)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(12)]
                            Label:
                                text: 'Long'
                                font_size: sp(11)
                                color: get_color_from_hex(text_muted)
                            Label:
                                id: pomo_long_display
                                text: 'after 4'
                                font_size: sp(16)
                                bold: True
                                color: get_color_from_hex(text_primary)

                    # Pomodoro Settings Button
                    Button:
                        text: 'Pomodoro Settings'
                        size_hint_y: None
                        height: dp(48)
                        font_size: sp(14)
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        color: get_color_from_hex(text_secondary)
                        on_press: app.root.current = 'pomo_settings'
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_card)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]

        # Quick Start Footer
        BoxLayout:
            size_hint_y: None
            height: dp(90) if root.current_tab == 'profiles' else 0
            opacity: 1 if root.current_tab == 'profiles' else 0
            padding: dp(16), dp(12)
            spacing: dp(12)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size
                # Top border
                Color:
                    rgba: get_color_from_hex(bg_tertiary)
                Rectangle:
                    pos: self.x, self.y + self.height - dp(1)
                    size: self.width, dp(1)

            # Quick Start Label
            Label:
                text: '⚡'
                font_size: sp(24)
                size_hint_x: None
                width: dp(40)

            # Minutes
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                Label:
                    text: 'MIN'
                    font_size: sp(10)
                    color: get_color_from_hex(text_muted)
                    bold: True
                BoxLayout:
                    spacing: dp(4)
                    Button:
                        text: '−'
                        size_hint: None, None
                        size: dp(32), dp(32)
                        font_size: sp(18)
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        color: get_color_from_hex(text_primary)
                        on_press: quick_min.text = str(max(1, int(quick_min.text) - 1))
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_tertiary)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(8)]
                    Label:
                        id: quick_min
                        text: '5'
                        font_size: sp(24)
                        bold: True
                        color: get_color_from_hex(accent_cyan)
                    Button:
                        text: '+'
                        size_hint: None, None
                        size: dp(32), dp(32)
                        font_size: sp(18)
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        color: get_color_from_hex(text_primary)
                        on_press: quick_min.text = str(min(60, int(quick_min.text) + 1))
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_tertiary)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(8)]

            # Intervals
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                Label:
                    text: 'INT'
                    font_size: sp(10)
                    color: get_color_from_hex(text_muted)
                    bold: True
                BoxLayout:
                    spacing: dp(4)
                    Button:
                        text: '−'
                        size_hint: None, None
                        size: dp(32), dp(32)
                        font_size: sp(18)
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        color: get_color_from_hex(text_primary)
                        on_press: quick_int.text = str(max(1, int(quick_int.text) - 1))
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_tertiary)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(8)]
                    Label:
                        id: quick_int
                        text: '4'
                        font_size: sp(24)
                        bold: True
                        color: get_color_from_hex(accent_cyan)
                    Button:
                        text: '+'
                        size_hint: None, None
                        size: dp(32), dp(32)
                        font_size: sp(18)
                        background_normal: ''
                        background_color: 0, 0, 0, 0
                        color: get_color_from_hex(text_primary)
                        on_press: quick_int.text = str(min(60, int(quick_int.text) + 1))
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_tertiary)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(8)]

            # GO Button
            Button:
                text: 'GO'
                size_hint: None, None
                size: dp(60), dp(60)
                font_size: sp(16)
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_press: root.start_quick_timer(int(quick_min.text), int(quick_int.text))
                canvas.before:
                    # Glow
                    Color:
                        rgba: get_color_from_hex(accent_green + '44')
                    Ellipse:
                        pos: self.x - dp(3), self.y - dp(3)
                        size: self.width + dp(6), self.height + dp(6)
                    Color:
                        rgba: get_color_from_hex(accent_green)
                    Ellipse:
                        pos: self.pos
                        size: self.size


# ============= PROFILE CARD =============
<ProfileCard>:
    size_hint_y: None
    height: dp(140)
    background_normal: ''
    background_color: 0, 0, 0, 0
    canvas.before:
        # Shadow
        Color:
            rgba: 0, 0, 0, 0.25
        RoundedRectangle:
            pos: self.x + dp(2), self.y - dp(2)
            size: self.size
            radius: [dp(16)]
        # Card background
        Color:
            rgba: get_color_from_hex(bg_card)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        # Color accent bar (left side)
        Color:
            rgba: get_color_from_hex(self.profile.get('color', '#6C63FF'))
        RoundedRectangle:
            pos: self.x, self.y
            size: dp(4), self.height
            radius: [dp(16), 0, 0, dp(16)]

    BoxLayout:
        orientation: 'vertical'
        padding: dp(16), dp(14)
        spacing: dp(6)
        pos: root.pos
        size: root.size

        # Icon and name row
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)

            # Icon circle with glow
            Widget:
                size_hint: None, None
                size: dp(44), dp(44)
                canvas:
                    # Glow
                    Color:
                        rgba: get_color_from_hex(root.profile.get('color', '#6C63FF') + '33')
                    Ellipse:
                        pos: self.x - dp(3), self.y - dp(3)
                        size: dp(50), dp(50)
                    # Circle
                    Color:
                        rgba: get_color_from_hex(root.profile.get('color', '#6C63FF'))
                    Ellipse:
                        pos: self.pos
                        size: self.size
                    # Icon
                    Color:
                        rgba: 1, 1, 1, 1
                    Line:
                        circle: self.center_x, self.center_y, dp(10)
                        width: dp(2)

            # Profile name
            Label:
                text: root.profile.get('name', 'Profile')
                font_size: sp(17)
                bold: True
                color: get_color_from_hex(text_primary)
                halign: 'left'
                valign: 'center'
                text_size: self.width, None
                shorten: True
                shorten_from: 'right'

        # Profile details
        BoxLayout:
            orientation: 'vertical'
            padding: dp(56), 0, 0, 0
            spacing: dp(2)

            Label:
                text: f"{root.profile.get('interval_minutes', 25)} min intervals"
                font_size: sp(12)
                color: get_color_from_hex(text_secondary)
                halign: 'left'
                text_size: self.width, None

            Label:
                text: f"{root.profile.get('session_minutes', 60)} min total"
                font_size: sp(12)
                color: get_color_from_hex(text_muted)
                halign: 'left'
                text_size: self.width, None


# ============= TIMER SCREEN =============
<TimerScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            IconButton:
                on_press: root.stop_timer() if root.status != 'idle' else setattr(app.root, 'current', 'home')
                canvas.after:
                    Color:
                        rgba: get_color_from_hex(text_primary)
                    Line:
                        points: [self.center_x + dp(4), self.center_y - dp(8), self.center_x - dp(6), self.center_y, self.center_x + dp(4), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'
                        joint: 'round'

            Label:
                text: root.profile_name
                font_size: sp(18)
                bold: True
                color: get_color_from_hex(text_primary)

            Widget:
                size_hint_x: None
                width: dp(44)

        # Timer Content
        BoxLayout:
            orientation: 'vertical'
            padding: dp(24)
            spacing: dp(20)

            # Status Badge
            BoxLayout:
                size_hint_y: None
                height: dp(36)
                padding: dp(100), 0

                Label:
                    text: root.status_text
                    font_size: sp(13)
                    bold: True
                    color: get_color_from_hex(accent_green) if root.status == 'running' else (get_color_from_hex(accent_orange) if root.status == 'break' else get_color_from_hex(text_secondary))
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(accent_green + '22') if root.status == 'running' else (get_color_from_hex(accent_orange + '22') if root.status == 'break' else get_color_from_hex(bg_tertiary))
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(18)]

            # Timer Display
            Widget:
                canvas:
                    # Outer glow
                    Color:
                        rgba: get_color_from_hex(root.timer_color + '11')
                    Line:
                        circle: self.center_x, self.center_y, dp(105)
                        width: dp(20)
                    # Background ring
                    Color:
                        rgba: get_color_from_hex(bg_tertiary)
                    Line:
                        circle: self.center_x, self.center_y, dp(95)
                        width: dp(10)
                    # Progress ring
                    Color:
                        rgba: get_color_from_hex(root.timer_color)
                    Line:
                        circle: self.center_x, self.center_y, dp(95), 90, 90 + root.progress * 360
                        width: dp(10)
                        cap: 'round'
                    # Inner circle
                    Color:
                        rgba: get_color_from_hex(bg_card)
                    Ellipse:
                        pos: self.center_x - dp(75), self.center_y - dp(75)
                        size: dp(150), dp(150)

                Label:
                    text: root.timer_display
                    font_size: sp(52)
                    bold: True
                    center: self.parent.center
                    color: get_color_from_hex(text_primary)

            # Timer Info
            BoxLayout:
                size_hint_y: None
                height: dp(60)
                spacing: dp(12)
                padding: dp(20), 0

                BoxLayout:
                    orientation: 'vertical'
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    Label:
                        text: root.intervals_info
                        font_size: sp(13)
                        color: get_color_from_hex(text_secondary)

                BoxLayout:
                    orientation: 'vertical'
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    Label:
                        text: root.session_info
                        font_size: sp(13)
                        color: get_color_from_hex(text_secondary)

            # Controls
            BoxLayout:
                size_hint_y: None
                height: dp(100)
                spacing: dp(20)
                padding: dp(20), 0

                Widget:

                # Stop Button
                Button:
                    size_hint: None, None
                    size: dp(56), dp(56)
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    opacity: 0 if root.status == 'idle' else 1
                    disabled: root.status == 'idle'
                    on_press: root.stop_timer() if root.status != 'idle' else None
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        Ellipse:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: get_color_from_hex(text_secondary)
                        Line:
                            circle: self.center_x, self.center_y, dp(24)
                            width: dp(2)
                    canvas.after:
                        Color:
                            rgba: get_color_from_hex(text_primary)
                        Rectangle:
                            pos: self.center_x - dp(6), self.center_y - dp(6)
                            size: dp(12), dp(12)

                # Main Control Button
                Button:
                    size_hint: None, None
                    size: dp(80), dp(80)
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    on_press: root.start_timer() if root.status == 'idle' else (root.pause_timer() if root.status == 'running' else root.resume_timer())
                    canvas.before:
                        # Glow
                        Color:
                            rgba: get_color_from_hex(root.timer_color + '44')
                        Ellipse:
                            pos: self.x - dp(4), self.y - dp(4)
                            size: self.width + dp(8), self.height + dp(8)
                        Color:
                            rgba: get_color_from_hex(root.timer_color)
                        Ellipse:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: 'Play' if root.status == 'idle' else ('||' if root.status == 'running' else 'Play')
                        font_size: sp(28)
                        center: self.parent.center
                        color: 1, 1, 1, 1

                # Skip Break Button
                Button:
                    size_hint: None, None
                    size: dp(56), dp(56)
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    opacity: 1 if root.status == 'break' else 0
                    disabled: root.status != 'break'
                    on_press: root.skip_break() if root.status == 'break' else None
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(accent_orange + '22')
                        Ellipse:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: get_color_from_hex(accent_orange)
                        Line:
                            circle: self.center_x, self.center_y, dp(24)
                            width: dp(2)
                    Label:
                        text: 'Skip'
                        font_size: sp(20)
                        center: self.parent.center
                        color: get_color_from_hex(accent_orange)

                Widget:


# ============= POMODORO SCREEN =============
<PomodoroScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            IconButton:
                on_press: root.stop_pomodoro() if root.status != 'idle' else setattr(app.root, 'current', 'home')
                canvas.after:
                    Color:
                        rgba: get_color_from_hex(text_primary)
                    Line:
                        points: [self.center_x + dp(4), self.center_y - dp(8), self.center_x - dp(6), self.center_y, self.center_x + dp(4), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'
                        joint: 'round'

            Label:
                text: 'Pomodoro'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex(text_primary)

            Widget:
                size_hint_x: None
                width: dp(44)

        # Content
        BoxLayout:
            orientation: 'vertical'
            padding: dp(24)
            spacing: dp(16)

            # Today Counter
            BoxLayout:
                size_hint_y: None
                height: dp(50)
                padding: dp(16), dp(8)
                canvas.before:
                    Color:
                        rgba: get_color_from_hex(accent_red + '22')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]

                Label:
                    text: f"Today: {root.today_count} sessions"
                    font_size: sp(16)
                    bold: True
                    color: get_color_from_hex(accent_red)

            # Task Input
            BoxLayout:
                size_hint_y: None
                height: dp(52)
                padding: dp(16), 0
                canvas.before:
                    Color:
                        rgba: get_color_from_hex(bg_card)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]

                TextInput:
                    id: task_input
                    hint_text: 'What are you working on?'
                    multiline: False
                    background_color: 0, 0, 0, 0
                    foreground_color: get_color_from_hex(text_primary)
                    hint_text_color: get_color_from_hex(text_muted)
                    cursor_color: get_color_from_hex(accent_red)
                    padding: 0, dp(14)

            # Status
            Label:
                text: root.status_text
                font_size: sp(14)
                bold: True
                color: get_color_from_hex(root.timer_color)
                size_hint_y: None
                height: dp(28)

            # Timer Display
            Widget:
                canvas:
                    # Outer glow
                    Color:
                        rgba: get_color_from_hex(root.timer_color + '11')
                    Line:
                        circle: self.center_x, self.center_y, dp(100)
                        width: dp(20)
                    # Background ring
                    Color:
                        rgba: get_color_from_hex(bg_tertiary)
                    Line:
                        circle: self.center_x, self.center_y, dp(90)
                        width: dp(10)
                    # Progress ring
                    Color:
                        rgba: get_color_from_hex(root.timer_color)
                    Line:
                        circle: self.center_x, self.center_y, dp(90), 90, 90 + root.progress * 360
                        width: dp(10)
                        cap: 'round'
                    # Inner circle
                    Color:
                        rgba: get_color_from_hex(bg_card)
                    Ellipse:
                        pos: self.center_x - dp(70), self.center_y - dp(70)
                        size: dp(140), dp(140)

                Label:
                    text: root.timer_display
                    font_size: sp(48)
                    bold: True
                    center: self.parent.center
                    color: get_color_from_hex(text_primary)

            # Controls
            BoxLayout:
                size_hint_y: None
                height: dp(100)
                spacing: dp(24)
                padding: dp(40), 0

                Widget:

                # Stop Button
                Button:
                    size_hint: None, None
                    size: dp(56), dp(56)
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    opacity: 0 if root.status == 'idle' else 1
                    disabled: root.status == 'idle'
                    on_press: root.stop_pomodoro()
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        Ellipse:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: get_color_from_hex(text_secondary)
                        Line:
                            circle: self.center_x, self.center_y, dp(24)
                            width: dp(2)
                    canvas.after:
                        Color:
                            rgba: get_color_from_hex(text_primary)
                        Rectangle:
                            pos: self.center_x - dp(6), self.center_y - dp(6)
                            size: dp(12), dp(12)

                # Main Control Button
                Button:
                    size_hint: None, None
                    size: dp(80), dp(80)
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    on_press: root.start_pomodoro() if root.status == 'idle' else (root.pause_pomodoro() if root.status != 'paused' else root.resume_pomodoro())
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(root.timer_color + '44')
                        Ellipse:
                            pos: self.x - dp(4), self.y - dp(4)
                            size: self.width + dp(8), self.height + dp(8)
                        Color:
                            rgba: get_color_from_hex(root.timer_color)
                        Ellipse:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: 'Play' if root.status == 'idle' else ('Play' if root.status == 'paused' else '||')
                        font_size: sp(28)
                        center: self.parent.center
                        color: 1, 1, 1, 1

                Widget:


# ============= EDITOR SCREEN =============
<EditorScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            IconButton:
                on_press: app.root.current = 'home'
                canvas.after:
                    Color:
                        rgba: get_color_from_hex(text_primary)
                    Line:
                        points: [self.center_x - dp(8), self.center_y - dp(8), self.center_x + dp(8), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'
                    Line:
                        points: [self.center_x + dp(8), self.center_y - dp(8), self.center_x - dp(8), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'

            Label:
                text: 'Edit Profile' if root.editing_profile else 'New Profile'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex(text_primary)

            Button:
                text: 'Save'
                size_hint_x: None
                width: dp(70)
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: get_color_from_hex(accent_blue)
                font_size: sp(15)
                bold: True
                on_press: root.save_profile()

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(20)

                # Profile Name
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(90)
                    spacing: dp(8)

                    Label:
                        text: 'Profile Name'
                        font_size: sp(13)
                        color: get_color_from_hex(text_muted)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(20)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(52)
                        padding: dp(16), 0
                        canvas.before:
                            Color:
                                rgba: get_color_from_hex(bg_card)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                        TextInput:
                            id: profile_name
                            hint_text: 'Enter profile name'
                            multiline: False
                            background_color: 0, 0, 0, 0
                            foreground_color: get_color_from_hex(text_primary)
                            hint_text_color: get_color_from_hex(text_muted)
                            cursor_color: get_color_from_hex(accent_blue)
                            padding: 0, dp(14)

                # Interval Duration
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    spacing: dp(8)

                    Label:
                        text: f'Interval Duration: {int(interval_slider.value)} min'
                        font_size: sp(13)
                        color: get_color_from_hex(text_muted)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(20)

                    Slider:
                        id: interval_slider
                        min: 1
                        max: 60
                        value: 25
                        size_hint_y: None
                        height: dp(44)

                # Session Duration
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    spacing: dp(8)

                    Label:
                        text: f'Session Duration: {int(session_slider.value)} min'
                        font_size: sp(13)
                        color: get_color_from_hex(text_muted)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(20)

                    Slider:
                        id: session_slider
                        min: 5
                        max: 240
                        value: 60
                        size_hint_y: None
                        height: dp(44)

                # Break Toggle
                BoxLayout:
                    size_hint_y: None
                    height: dp(56)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: 'Break Reminders'
                        font_size: sp(14)
                        color: get_color_from_hex(text_primary)
                        halign: 'left'
                        text_size: self.size
                        valign: 'center'

                    Switch:
                        id: break_toggle
                        size_hint_x: None
                        width: dp(60)

                # Break Settings
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(160) if break_toggle.active else 0
                    opacity: 1 if break_toggle.active else 0
                    spacing: dp(16)
                    padding: dp(16)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(60)

                        Label:
                            text: f'Break after: {int(break_interval_slider.value)} intervals'
                            font_size: sp(12)
                            color: get_color_from_hex(text_secondary)
                            halign: 'left'
                            text_size: self.size

                        Slider:
                            id: break_interval_slider
                            min: 1
                            max: 10
                            value: 4

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(60)

                        Label:
                            text: f'Break duration: {int(break_duration_slider.value)} min'
                            font_size: sp(12)
                            color: get_color_from_hex(text_secondary)
                            halign: 'left'
                            text_size: self.size

                        Slider:
                            id: break_duration_slider
                            min: 1
                            max: 15
                            value: 5

                # Colors
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(100)
                    spacing: dp(12)

                    Label:
                        text: 'Color'
                        font_size: sp(13)
                        color: get_color_from_hex(text_muted)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(20)

                    GridLayout:
                        cols: 6
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(50)

                        Button:
                            background_normal: ''
                            background_color: 0, 0, 0, 0
                            size_hint: None, None
                            size: dp(44), dp(44)
                            on_press: root.select_color('#6C63FF')
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex('#6C63FF')
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        Button:
                            background_normal: ''
                            background_color: 0, 0, 0, 0
                            size_hint: None, None
                            size: dp(44), dp(44)
                            on_press: root.select_color('#00E676')
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex('#00E676')
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        Button:
                            background_normal: ''
                            background_color: 0, 0, 0, 0
                            size_hint: None, None
                            size: dp(44), dp(44)
                            on_press: root.select_color('#FF9100')
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex('#FF9100')
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        Button:
                            background_normal: ''
                            background_color: 0, 0, 0, 0
                            size_hint: None, None
                            size: dp(44), dp(44)
                            on_press: root.select_color('#FF4081')
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex('#FF4081')
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        Button:
                            background_normal: ''
                            background_color: 0, 0, 0, 0
                            size_hint: None, None
                            size: dp(44), dp(44)
                            on_press: root.select_color('#B388FF')
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex('#B388FF')
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        Button:
                            background_normal: ''
                            background_color: 0, 0, 0, 0
                            size_hint: None, None
                            size: dp(44), dp(44)
                            on_press: root.select_color('#00D9FF')
                            canvas.before:
                                Color:
                                    rgba: get_color_from_hex('#00D9FF')
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                # Delete Button
                Button:
                    text: 'Delete Profile'
                    size_hint_y: None
                    height: dp(52)
                    font_size: sp(14)
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    color: get_color_from_hex(accent_red)
                    opacity: 1 if root.editing_profile else 0
                    on_press: root.delete_profile() if root.editing_profile else None
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(accent_red + '22') if root.editing_profile else (0, 0, 0, 0)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]


# ============= SETTINGS SCREEN =============
<SettingsScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            IconButton:
                on_press: app.root.current = 'home'
                canvas.after:
                    Color:
                        rgba: get_color_from_hex(text_primary)
                    Line:
                        points: [self.center_x + dp(4), self.center_y - dp(8), self.center_x - dp(6), self.center_y, self.center_x + dp(4), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'
                        joint: 'round'

            Label:
                text: 'Settings'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex(text_primary)

            Widget:
                size_hint_x: None
                width: dp(44)

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(12)

                Label:
                    text: 'TIMER'
                    font_size: sp(11)
                    color: get_color_from_hex(accent_blue)
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(28)
                    bold: True

                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Sound'
                            font_size: sp(15)
                            color: get_color_from_hex(text_primary)
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Play sound on interval complete'
                            font_size: sp(11)
                            color: get_color_from_hex(text_muted)
                            halign: 'left'
                            text_size: self.size
                    Switch:
                        id: sound_toggle
                        size_hint_x: None
                        width: dp(60)
                        on_active: root.save_setting('sound', self.active)

                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Vibration'
                            font_size: sp(15)
                            color: get_color_from_hex(text_primary)
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Vibrate on interval complete'
                            font_size: sp(11)
                            color: get_color_from_hex(text_muted)
                            halign: 'left'
                            text_size: self.size
                    Switch:
                        id: vibration_toggle
                        size_hint_x: None
                        width: dp(60)
                        on_active: root.save_setting('vibration', self.active)

                Label:
                    text: 'DISPLAY'
                    font_size: sp(11)
                    color: get_color_from_hex(accent_blue)
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(28)
                    bold: True

                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Dark Theme'
                            font_size: sp(15)
                            color: get_color_from_hex(text_primary)
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Dark mode interface'
                            font_size: sp(11)
                            color: get_color_from_hex(text_muted)
                            halign: 'left'
                            text_size: self.size
                    Switch:
                        id: dark_toggle
                        size_hint_x: None
                        width: dp(60)
                        on_active: root.save_setting('dark_theme', self.active)


# ============= POMODORO SETTINGS SCREEN =============
<PomodoroSettingsScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            IconButton:
                on_press: app.root.current = 'home'
                canvas.after:
                    Color:
                        rgba: get_color_from_hex(text_primary)
                    Line:
                        points: [self.center_x + dp(4), self.center_y - dp(8), self.center_x - dp(6), self.center_y, self.center_x + dp(4), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'
                        joint: 'round'

            Label:
                text: 'Pomodoro Settings'
                font_size: sp(16)
                bold: True
                color: get_color_from_hex(text_primary)

            Button:
                text: 'Save'
                size_hint_x: None
                width: dp(70)
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: get_color_from_hex(accent_blue)
                font_size: sp(15)
                bold: True
                on_press: root.save_settings()

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(12)

                Label:
                    text: 'TIMER DURATIONS'
                    font_size: sp(11)
                    color: get_color_from_hex(accent_red)
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(24)
                    bold: True

                # Focus Duration
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: f'Focus Duration: {int(focus_slider.value)} min'
                        font_size: sp(13)
                        color: get_color_from_hex(text_primary)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Slider:
                        id: focus_slider
                        min: 5
                        max: 60
                        value: 25

                # Short Break
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: f'Short Break: {int(short_break_slider.value)} min'
                        font_size: sp(13)
                        color: get_color_from_hex(text_primary)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Slider:
                        id: short_break_slider
                        min: 1
                        max: 15
                        value: 5

                # Long Break
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: f'Long Break: {int(long_break_slider.value)} min'
                        font_size: sp(13)
                        color: get_color_from_hex(text_primary)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Slider:
                        id: long_break_slider
                        min: 10
                        max: 30
                        value: 15

                Label:
                    text: 'BREAK SCHEDULE'
                    font_size: sp(11)
                    color: get_color_from_hex(accent_red)
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(24)
                    bold: True

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: f'Long Break after: {int(sessions_slider.value)} pomodoros'
                        font_size: sp(13)
                        color: get_color_from_hex(text_primary)
                        halign: 'left'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Slider:
                        id: sessions_slider
                        min: 2
                        max: 8
                        value: 4

                Label:
                    text: 'AUTO-START'
                    font_size: sp(11)
                    color: get_color_from_hex(accent_red)
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(24)
                    bold: True

                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Auto-start Breaks'
                            font_size: sp(14)
                            color: get_color_from_hex(text_primary)
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Start break after focus'
                            font_size: sp(11)
                            color: get_color_from_hex(text_muted)
                            halign: 'left'
                            text_size: self.size
                    Switch:
                        id: auto_break_toggle
                        size_hint_x: None
                        width: dp(60)

                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    padding: dp(16), dp(8)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex(bg_card)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Auto-start Focus'
                            font_size: sp(14)
                            color: get_color_from_hex(text_primary)
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Start focus after break'
                            font_size: sp(11)
                            color: get_color_from_hex(text_muted)
                            halign: 'left'
                            text_size: self.size
                    Switch:
                        id: auto_focus_toggle
                        size_hint_x: None
                        width: dp(60)


# ============= STATS SCREEN =============
<StatsScreen>:
    canvas.before:
        Color:
            rgba: get_color_from_hex(bg_primary)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(8)
            canvas.before:
                Color:
                    rgba: get_color_from_hex(bg_secondary)
                Rectangle:
                    pos: self.pos
                    size: self.size

            IconButton:
                on_press: app.root.current = 'home'
                canvas.after:
                    Color:
                        rgba: get_color_from_hex(text_primary)
                    Line:
                        points: [self.center_x + dp(4), self.center_y - dp(8), self.center_x - dp(6), self.center_y, self.center_x + dp(4), self.center_y + dp(8)]
                        width: dp(2)
                        cap: 'round'
                        joint: 'round'

            Label:
                text: 'Statistics'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex(text_primary)

            Widget:
                size_hint_x: None
                width: dp(44)

        BoxLayout:
            orientation: 'vertical'
            padding: dp(20)
            spacing: dp(16)

            Label:
                text: 'Last 7 Days'
                font_size: sp(13)
                color: get_color_from_hex(text_muted)
                size_hint_y: None
                height: dp(28)

            GridLayout:
                cols: 2
                spacing: dp(12)
                size_hint_y: None
                height: dp(220)

                # Minutes Card
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(20)
                    canvas.before:
                        # Shadow
                        Color:
                            rgba: 0, 0, 0, 0.2
                        RoundedRectangle:
                            pos: self.x + dp(2), self.y - dp(2)
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_blue + '22')
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_blue)
                        RoundedRectangle:
                            pos: self.x, self.y + self.height - dp(4)
                            size: self.width, dp(4)
                            radius: [dp(16), dp(16), 0, 0]

                    Label:
                        text: root.total_minutes
                        font_size: sp(36)
                        bold: True
                        color: get_color_from_hex(text_primary)
                    Label:
                        text: 'Minutes'
                        font_size: sp(14)
                        color: get_color_from_hex(text_muted)

                # Sessions Card
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(20)
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.2
                        RoundedRectangle:
                            pos: self.x + dp(2), self.y - dp(2)
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_green + '22')
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_green)
                        RoundedRectangle:
                            pos: self.x, self.y + self.height - dp(4)
                            size: self.width, dp(4)
                            radius: [dp(16), dp(16), 0, 0]

                    Label:
                        text: root.completed_sessions
                        font_size: sp(36)
                        bold: True
                        color: get_color_from_hex(text_primary)
                    Label:
                        text: 'Sessions'
                        font_size: sp(14)
                        color: get_color_from_hex(text_muted)

                # Active Days Card
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(20)
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.2
                        RoundedRectangle:
                            pos: self.x + dp(2), self.y - dp(2)
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_orange + '22')
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_orange)
                        RoundedRectangle:
                            pos: self.x, self.y + self.height - dp(4)
                            size: self.width, dp(4)
                            radius: [dp(16), dp(16), 0, 0]

                    Label:
                        text: root.active_days
                        font_size: sp(36)
                        bold: True
                        color: get_color_from_hex(text_primary)
                    Label:
                        text: 'Active Days'
                        font_size: sp(14)
                        color: get_color_from_hex(text_muted)

                # Pomodoros Card
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(20)
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.2
                        RoundedRectangle:
                            pos: self.x + dp(2), self.y - dp(2)
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_red + '22')
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: get_color_from_hex(accent_red)
                        RoundedRectangle:
                            pos: self.x, self.y + self.height - dp(4)
                            size: self.width, dp(4)
                            radius: [dp(16), dp(16), 0, 0]

                    Label:
                        text: '0'
                        font_size: sp(36)
                        bold: True
                        color: get_color_from_hex(text_primary)
                    Label:
                        text: 'Pomodoros'
                        font_size: sp(14)
                        color: get_color_from_hex(text_muted)

            Widget:
